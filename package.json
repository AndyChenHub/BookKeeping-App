{
  "name": "bookkeeping-app",
  "private": true,
  "version": "2.0.0",
  "description": "Simple bookkeeping app for computer and phone with Excel sync and daily backups",
  "author": "BookKeeping",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build:web": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:web && npm run build:electron",
    "start": "node dist-electron/server.cjs",
    "local": "npm run build && cross-env NODE_ENV=production node dist-electron/server.cjs --open",
    "lint": "tsc --noEmit",
    "electron:dev": "npm run build && cross-env ELECTRON_RUN_AS_NODE= electron .",
    "electron:package": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "open": "^11.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.bookkeeping.ledger",
    "productName": "BookKeeping",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "BookKeeping.exe",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "BookKeeping.exe"
    },
    "asar": true,
    "asarUnpack": [
      "dist/**/*"
    ]
  }
}
